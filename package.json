{
  "name": "@nakednous/api-docs",
  "version": "0.1.0",
  "description": "The shared API reference scaffold for the nakednous libraries: ESM-only, CodeMirror 6, one editor bundle.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakednous/api-docs.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./src/editor.js",
    "./manifest.json": "./dist/manifest.json"
  },
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "esbuild": "0.28.2",
    "jsdom": "31.0.1"
  }
}
